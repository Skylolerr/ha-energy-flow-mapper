# Copy to .env and adjust. .env is git-ignored.

# SSH access to Home Assistant (add-on "Advanced SSH & Web Terminal" or "Terminal & SSH")
HA_HOST=homeassistant.local
HA_USER=root
HA_SSH_PORT=22
# Home Assistant configuration directory on the host (usually /config)
HA_CONFIG_PATH=/config

# Optional: restart Home Assistant after deploying via the REST API.
# Create a long-lived access token in your HA profile (Security tab).
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
